{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Simulate",
      "type": "python",
      "program": "${workspaceFolder}/scenes/ExecuteUpdate.py",
      "request": "launch",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Render",
      "type": "python",
      "module": "manim",
      "args": ["-qh", "scenes/scene.py", "TemporalScene"],
      "env": {
        "TEMPORAL_ANIMATIONS_EVENTS_FILE": "scenes/events/ExecuteUpdate.jsonl"
      },
      "request": "launch",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
